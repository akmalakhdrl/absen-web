# Port server Express
PORT=3000

# Daftar prefix IP yang diizinkan (dipisah koma).
# Request dari IP yang memiliki prefix sesuai daftar akan dianggap berasal
# dari WiFi/jaringan lokal yang valid. Cocokkan dengan range IP WiFi kantor.
# Localhost (127.0.0.1, ::1) selalu diizinkan.
ALLOWED_IP_PREFIXES=192.168.1.,192.168.0.,10.0.0.

# Aktifkan/nonaktifkan validasi WiFi.
# Set ke "false" saat development jika tidak ingin diblokir.
ENFORCE_WIFI_VALIDATION=true

# Path file database SQLite (relatif terhadap folder backend)
DB_FILE=./data/attendance.db

# Path folder upload foto (relatif terhadap folder backend)
UPLOAD_DIR=./uploads

# Ukuran maksimum file upload (dalam bytes). Default 5 MB.
MAX_UPLOAD_SIZE=5242880
