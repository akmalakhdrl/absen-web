{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/server.js" },
    { "src": "/uploads/(.*)", "dest": "backend/server.js" },
    { "src": "/css/(.*)", "dest": "css/$1" },
    { "src": "/js/(.*)", "dest": "js/$1" },
    { "src": "/", "dest": "index.html" },
    { "src": "/index.html", "dest": "index.html" }
  ]
}
